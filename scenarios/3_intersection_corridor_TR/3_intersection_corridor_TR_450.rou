# -*- coding: utf-8 -*-
"""
Created on Tue Apr 28 16:52:18 2026

@author: Ryan Lu
"""

<routes>

    <!-- Random routes for each entry road -->

    <routeDistribution id="rd_E01">
        <route edges="E01 E12 E23" probability="0.25"/>
        <route edges="E01 E12 E26" probability="0.25"/>
        <route edges="E01 E12 -E92" probability="0.25"/>
        <route edges="E01 E15" probability="0.25"/>
    </routeDistribution>

    <routeDistribution id="rd_E81">
        <route edges="E81 E12 E23" probability="0.25"/>
        <route edges="E81 E12 E26" probability="0.25"/>
        <route edges="E81 E12 -E92" probability="0.25"/>
        <route edges="E81 E15" probability="0.25"/>
    </routeDistribution>

    <routeDistribution id="rd_minus_E15">
        <route edges="-E15 E12 E23" probability="0.25"/>
        <route edges="-E15 E12 E26" probability="0.25"/>
        <route edges="-E15 E12 -E92" probability="0.25"/>
        <route edges="-E15 -E01" probability="0.25"/>
    </routeDistribution>

    <routeDistribution id="rd_minus_E26">
        <route edges="-E26 -E12" probability="0.25"/>
        <route edges="-E26 E23 E34" probability="0.25"/>
        <route edges="-E26 E23 E37" probability="0.25"/>
        <route edges="-E26 -E92" probability="0.25"/>
    </routeDistribution>

    <routeDistribution id="rd_E92">
        <route edges="E92 E23 E34" probability="0.25"/>
        <route edges="E92 E23 E37" probability="0.25"/>
        <route edges="E92 E23 -E103" probability="0.25"/>
        <route edges="E92 -E12 E15" probability="0.25"/>
    </routeDistribution>

    <routeDistribution id="rd_minus_E37">
        <route edges="-E37 -E23 -E12" probability="0.25"/>
        <route edges="-E37 -E23 -E12 -E01" probability="0.25"/>
        <route edges="-E37 -E23 E26" probability="0.25"/>
        <route edges="-E37 -E103" probability="0.25"/>
    </routeDistribution>

    <routeDistribution id="rd_E103">
        <route edges="E103 -E23 -E12" probability="0.25"/>
        <route edges="E103 -E23 -E12 -E01" probability="0.25"/>
        <route edges="E103 -E23 E26" probability="0.25"/>
        <route edges="E103 E37" probability="0.25"/>
    </routeDistribution>


    <!-- Demand: each entry road = 1800 veh/hr -->

    <flow id="flow_E01" begin="0" end="900" vehsPerHour="450" route="rd_E01" departLane="random" departSpeed="max"/>
    <flow id="flow_E81" begin="0" end="900" vehsPerHour="450" route="rd_E81" departLane="random" departSpeed="max"/>
    <flow id="flow_minus_E15" begin="0" end="900" vehsPerHour="450" route="rd_minus_E15" departLane="random" departSpeed="max"/>
    <flow id="flow_minus_E26" begin="0" end="900" vehsPerHour="450" route="rd_minus_E26" departLane="random" departSpeed="max"/>
    <flow id="flow_E92" begin="0" end="900" vehsPerHour="450" route="rd_E92" departLane="random" departSpeed="max"/>
    <flow id="flow_minus_E37" begin="0" end="900" vehsPerHour="450" route="rd_minus_E37" departLane="random" departSpeed="max"/>
    <flow id="flow_E103" begin="0" end="900" vehsPerHour="450" route="rd_E103" departLane="random" departSpeed="max"/>

</routes>
