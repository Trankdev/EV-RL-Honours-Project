"""rewards for traffic signals."""

import numpy as np

try:
    from .Observations import ObservationFunction
except ImportError:
    from Observations import ObservationFunction


class GetRewards(ObservationFunction):
    """Reward function for traffic signals."""

    REWARD_CONFIGS = {
        'lane_waiting_count': {
            'description': 'Number of waiting vehicles per lane',
            'level': 'lane',
            'use_difference': False,
            'negative': True,
            'scale': 1.0,
            'clip_range': None
        },

        'lane_waiting_time_count': {
            'description': 'Total waiting time per lane',
            'level': 'lane',
            'use_difference': False,
            'negative': True,
            'scale': 1.0,
            'clip_range': None
        },

        'lane_vehicle_count': {
            'description': 'Total number of vehicles per lane',
            'level': 'lane',
            'use_difference': False,
            'negative': False,
            'scale': 1.0,
            'clip_range': None
        },

        'avg_waiting_time_per_vehicle': {
            'description': 'Average waiting time per vehicle',
            'level': 'intersection',
            'use_difference': False,
            'negative': True,
            'scale': 1.0,
            'clip_range': (-10.0, 0.0)
        },

        'pressure': {
            'description': 'Pressure reward',
            'level': 'intersection',
            'negative': True,
            'scale': 1.0,
        },

        'emergency_vehicle_priority': {
            'description': 'Priority rewards for ambulances',
            'level': 'intersection',
            'negative': True,
            'civilian_weight': 0.7,
            'ambulance_penalty': 5000,
            'ambulance_speed_threshold': 1.0,
            'ambulance_type_id': 'ambulance_type',
            'scale': 1.0,
            'clip_range': None
        },

        'project1_std_reward': {
            'description': 'project1_std_reward: 50 - (reg_mean + K*reg_std + Z*(emg_mean + K*emg_std))',
            'level': 'intersection',
            'negative': False,
            'K': 0.5,
            'Z': 1.0,
            'base_reward': 50.0,
            'scale': 1.0,
            'clip_range': None,
            'ambulance_type_ids': ['ambulance_type', 'emergency']
        },

        'final_year_project_reward': {
            'description': 'FYP reward: weighted queue with EV lane weight',
            'level': 'intersection',
            'negative': False,

            'K': 0.5,
            'Z': 1.0,
            'Y': 1.0,
            'X': 1.0,
            'base_reward': 50.0,
            'scale': 1.0,
            'clip_range': None,

            'ambulance_type_ids': ['ambulance_type', 'emergency']
        },
    }

    def __init__(self, ts, world, reward_to_subscribe, in_only=True, negative=True):
        super().__init__(ts, world)

        #######################################################################
        # Local intersection lanes
        #######################################################################

        self.lanes_road_observed = []

        if in_only:
            roads = self.ts.in_roads
        else:
            roads = self.ts.roads

        for r in roads:
            if not self.world.RIGHT:
                tmp = sorted(
                    self.ts.road_lane_mapping[r],
                    key=lambda ob: int(ob[-1]),
                    reverse=True
                )
            else:
                tmp = sorted(
                    self.ts.road_lane_mapping[r],
                    key=lambda ob: int(ob[-1])
                )

            self.lanes_road_observed.append(tmp)

        #######################################################################
        # Subscription
        #######################################################################

        if 'emergency_vehicle_priority' in reward_to_subscribe:
            self.world.subscribe(['lane_waiting_time_count'])
        else:
            self.world.subscribe(reward_to_subscribe)

        self.fns_subscribed = reward_to_subscribe
        self.negative = negative
        self.algorithm_name = getattr(world, '_algorithm_name', 'default')
        self.last_rewards = {fn: None for fn in self.fns_subscribed}

        #######################################################################
        # Local intersection delay tracking for evaluation
        #######################################################################

        # Each GetRewards object belongs to one intersection.
        # Therefore this accumulator stores LOCAL delay for this intersection.
        self.local_delay_records = {}

        # Used to reset local delay records when a new episode starts.
        self.last_local_delay_sim_time = None

    ###########################################################################
    # Main reward selector
    ###########################################################################

    def compute_reward(self) -> float:
        """
        Compute reward with multiple algorithm-specific modes.

        project1 / std_dqn:
            uses old baseline reward.

        final_year_project / fyp:
            uses new weighted queue FYP reward.
        """

        name = self.algorithm_name.lower()

        if 'project1' in name or 'std_dqn' in name:
            return self._compute_project1_std_reward()

        if 'final_year_project' in name or 'fyp' in name:
            return self._compute_project1_std_reward_new()

        print(
            "The reward function is likely not being computed correctly. "
            "Use 'project1_std_dqn' for baseline or 'final_year_project' / 'fyp' "
            "for the FYP reward."
        )

        if 'emergency_vehicle_priority' in self.fns_subscribed:
            return self._compute_emergency_priority_reward()

        subscribed_results = [
            self.world.info_dynamics_real_time[fn]
            for fn in self.fns_subscribed
        ]

        if 'ma2c' in name:
            return self._compute_ma2c_reward(subscribed_results)

        return self._compute_default_reward(subscribed_results)

    ###########################################################################
    # Compatibility reward functions
    ###########################################################################

    def _compute_emergency_priority_reward(self):
        """
        Old emergency vehicle priority reward.

        reward = -[(civilian_penalty * 0.7) + ambulance_penalty]
        """
        config = self.REWARD_CONFIGS['emergency_vehicle_priority']

        waiting_time_result = self.world.info_dynamics_real_time.get(
            'lane_waiting_time_count',
            {}
        )

        civilian_penalty = 0.0

        for road_lanes in self.lanes_road_observed:
            for lane_id in road_lanes:
                civilian_penalty += waiting_time_result.get(lane_id, 0.0)

        ambulance_penalty = 0.0

        try:
            eng = self.world.eng
            vehicle_list = eng.vehicle.getIDList()

            ambulance_type = config['ambulance_type_id']
            speed_threshold = config['ambulance_speed_threshold']
            penalty_value = config['ambulance_penalty']

            for veh_id in vehicle_list:
                try:
                    veh_type = eng.vehicle.getTypeID(veh_id)

                    if veh_type == ambulance_type:
                        speed = eng.vehicle.getSpeed(veh_id)

                        if speed < speed_threshold:
                            ambulance_penalty += penalty_value

                except Exception:
                    pass

        except Exception:
            pass

        civilian_weight = config['civilian_weight']
        raw_value = (civilian_penalty * civilian_weight) + ambulance_penalty

        reward = -raw_value / config.get('scale', 1.0)

        return float(reward)

    def _compute_ma2c_reward(self, subscribed_results) -> float:
        """
        MA2C-style reward kept for compatibility.
        """
        reward_weights = getattr(self.world, '_reward_weights', [1.0, 0.2])
        reward_scale = getattr(self.world, '_reward_scale', 2000.0)
        reward_clip_range = getattr(
            self.world,
            '_reward_clip_range',
            [-2.0, 2.0]
        )

        reward_components = []

        for i, fn_name in enumerate(self.fns_subscribed):
            result = subscribed_results[i]
            fn_result = []

            for road_lanes in self.lanes_road_observed:
                road_result = [
                    result.get(lane_id, 0.0)
                    if hasattr(result, 'get')
                    else result[lane_id]
                    for lane_id in road_lanes
                ]

                fn_result.extend(road_result)

            raw_value = np.sum(fn_result)
            reward_components.append(-raw_value)

        weighted_reward = sum(
            w * r for w, r in zip(reward_weights, reward_components)
        )

        normalized_reward = weighted_reward / reward_scale

        if reward_clip_range:
            clipped_reward = np.clip(
                normalized_reward,
                reward_clip_range[0],
                reward_clip_range[1]
            )
        else:
            clipped_reward = normalized_reward

        return float(clipped_reward)

    def _compute_default_reward(self, subscribed_results) -> float:
        """
        Default reward mode for non-FYP algorithms.
        """
        reward_components = []

        for i, fn_name in enumerate(self.fns_subscribed):
            result = subscribed_results[i]
            config = self.REWARD_CONFIGS[fn_name]

            if fn_name == 'pressure':
                raw_value = result[self.ts.id]

            elif fn_name in [
                'lane_waiting_count',
                'lane_waiting_time_count',
                'lane_vehicle_count'
            ]:
                fn_result = []

                for road_lanes in self.lanes_road_observed:
                    road_result = [
                        result.get(lane_id, 0.0)
                        if hasattr(result, 'get')
                        else result[lane_id]
                        for lane_id in road_lanes
                    ]

                    fn_result.append(np.sum(road_result))

                raw_value = np.sum(fn_result)

            elif fn_name == 'emergency_vehicle_priority':
                raw_value = -self._compute_emergency_priority_reward()

            else:
                raise ValueError(f"Unknown reward type: {fn_name}")

            value = -raw_value if config['negative'] else raw_value
            value = value / config['scale']

            if config.get('clip_range'):
                value = np.clip(
                    value,
                    config['clip_range'][0],
                    config['clip_range'][1]
                )

            reward_components.append(value)

        return float(reward_components[0])

    ###########################################################################
    # Baseline Project1 reward
    ###########################################################################

    def _compute_project1_std_reward(self) -> float:
        """
        Project1 standard deviation-aware reward.

        reward = 50 - ((reg_mean + K*reg_std) + Z*(emg_mean + K*emg_std))
        """

        config = self.REWARD_CONFIGS['project1_std_reward']

        K = config['K']
        Z = config['Z']
        base_reward = config['base_reward']
        ambulance_type_ids = config['ambulance_type_ids']

        regular_waiting_times = []
        emergency_waiting_times = []

        eng = self.world.eng

        for road_lanes in self.lanes_road_observed:
            for lane_id in road_lanes:
                try:
                    vehicle_ids = eng.lane.getLastStepVehicleIDs(lane_id)

                    for veh_id in vehicle_ids:
                        try:
                            waiting_time = eng.vehicle.getAccumulatedWaitingTime(
                                veh_id
                            )

                            veh_type = eng.vehicle.getTypeID(veh_id)

                            if veh_type in ambulance_type_ids:
                                emergency_waiting_times.append(waiting_time)
                            else:
                                regular_waiting_times.append(waiting_time)

                        except Exception:
                            continue

                except Exception:
                    continue

        reg_mean = (
            float(np.mean(regular_waiting_times))
            if len(regular_waiting_times) > 0
            else 0.0
        )

        reg_std = (
            float(np.std(regular_waiting_times))
            if len(regular_waiting_times) > 0
            else 0.0
        )

        emg_mean = (
            float(np.mean(emergency_waiting_times))
            if len(emergency_waiting_times) > 0
            else 0.0
        )

        emg_std = (
            float(np.std(emergency_waiting_times))
            if len(emergency_waiting_times) > 0
            else 0.0
        )

        reward = base_reward - (
            (reg_mean + K * reg_std)
            + Z * (emg_mean + K * emg_std)
        )

        return float(reward)

