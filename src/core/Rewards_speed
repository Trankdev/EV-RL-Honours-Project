    # FYP reward helpers
    ###########################################################################

    def _detect_emergency_vehicle(self, ambulance_type_ids):
        """Detect first emergency vehicle observed by this intersection."""
        eng = self.world.eng

        for road_lanes in self.lanes_road_observed:
            for lane_id in road_lanes:
                try:
                    vehicle_ids = eng.lane.getLastStepVehicleIDs(lane_id)

                    for veh_id in vehicle_ids:
                        try:
                            veh_type = eng.vehicle.getTypeID(veh_id)

                            if veh_type in ambulance_type_ids:
                                return {
                                    'id': veh_id,
                                    'lane_id': eng.vehicle.getLaneID(veh_id),
                                    'position': eng.vehicle.getLanePosition(veh_id),
                                    'speed': eng.vehicle.getSpeed(veh_id),
                                    'road_lanes': road_lanes,
                                }

                        except Exception:
                            continue

                except Exception:
                    continue

        return None

    def _safe_mean(self, values):
        if len(values) == 0:
            return 0.0
        return float(np.mean(values))

    def _safe_std(self, values):
        if len(values) == 0:
            return 0.0
        return float(np.std(values))

    def _compute_fyp_v7_reward_components(self, Z=None):
        """
        v7 FYP reward.

        Main change from v6:
            - v6 reduced Group 2 wait, but made civilian trip time and EMV trip time worse.
            - v7 relaxes Group 2 pressure slightly.
            - v7 adds a regular-speed reward to help civilian trip time.
            - v7 strengthens EV movement again to recover EMV trip time.
        """

        config = self.REWARD_CONFIGS['final_year_project_reward']

        Z = Z if Z is not None else config.get('Z', 1.0)
        ambulance_type_ids = config.get(
            'ambulance_type_ids',
            ['ambulance_type', 'emergency']
        )

        max_tta = config.get('max_tta', 30.0)
        eps = config.get('eps', 1e-6)
        max_weight = config.get('max_weight', 10.0)
        speed_norm = config.get('speed_norm', 13.89)

        reward_clip_min = config.get('reward_clip_min', -20.0)
        reward_clip_max = config.get('reward_clip_max', 12.0)

        ev_clear_reward_weight = config.get('ev_clear_reward_weight', 7.5)
        ev_speed_reward_weight = config.get('ev_speed_reward_weight', 4.0)
        normal_flow_reward_weight = config.get('normal_flow_reward_weight', 3.0)
        regular_speed_reward_weight = config.get('regular_speed_reward_weight', 3.0)

        front_vehicle_cost_weight = config.get('front_vehicle_cost_weight', 3.0)
        front_halting_cost_weight = config.get('front_halting_cost_weight', 6.0)
        emergency_wait_cost_weight = config.get('emergency_wait_cost_weight', 6.0)
        group1_wait_cost_weight = config.get('group1_wait_cost_weight', 2.5)
        ev_slow_cost_weight = config.get('ev_slow_cost_weight', 2.5)

        group2_wait_cost_weight = config.get('group2_wait_cost_weight', 1.4)
        group2_std_cost_weight = config.get('group2_std_cost_weight', 0.45)
        group2_excess_wait_cost_weight = config.get('group2_excess_wait_cost_weight', 0.8)
        group2_target_wait = config.get('group2_target_wait', 35.0)
        halting_per_lane_cost_weight = config.get('halting_per_lane_cost_weight', 1.3)
        occupancy_per_lane_cost_weight = config.get('occupancy_per_lane_cost_weight', 0.30)
        civilian_multiplier_max = config.get('civilian_multiplier_max', 1.4)

        wait_norm = config.get('wait_norm', 30.0)
        ev_wait_norm = config.get('ev_wait_norm', 10.0)
        std_norm = config.get('std_norm', 30.0)
        halting_norm = config.get('halting_norm', 5.0)
        occupancy_norm = config.get('occupancy_norm', 10.0)

        eng = self.world.eng

        # Step 1: detect EV.
        ev_info = self._detect_emergency_vehicle(ambulance_type_ids)
        EV_present = ev_info is not None

        EV_id = ev_info['id'] if EV_present else None
        EV_lane_id = ev_info['lane_id'] if EV_present else None
        EV_position = ev_info['position'] if EV_present else None
        EV_speed = max(ev_info['speed'], 0.0) if EV_present else 0.0

        # Step 2: EV time-to-arrival weight.
        EV_tta = None
        EV_tta_norm = 1.0
        EV_weight = 1.0

        if EV_present:
            try:
                lane_length = eng.lane.getLength(EV_lane_id)
                dist_to_stop = max(lane_length - EV_position, 0.0)

                speed_for_tta = max(EV_speed, 1e-3)
                EV_tta = dist_to_stop / speed_for_tta

                EV_tta_norm = min(EV_tta / max_tta, 1.0)

                EV_weight = 1.0 + Z / max(EV_tta_norm, eps)
                EV_weight = min(EV_weight, max_weight)

            except Exception:
                EV_tta = None
                EV_tta_norm = 1.0
                EV_weight = 1.0

        # Step 3: collect traffic state.
        regular_group1_waiting_times = []
        regular_group2_waiting_times = []
        emergency_waiting_times = []
        regular_speeds = []
        group2_speeds = []

        lane_queues = []
        lane_weights = []
        road_vehicle_counts = []

        total_vehicle_count = 0
        total_halting_count = 0
        total_lane_count = 0

        ev_front_vehicle_count = 0
        ev_front_halting_count = 0

        for road_lanes in self.lanes_road_observed:
            road_vehicle_count = 0

            for lane_id in road_lanes:
                try:
                    vehicle_ids = eng.lane.getLastStepVehicleIDs(lane_id)
                    road_vehicle_count += len(vehicle_ids)
                except Exception:
                    continue

            road_vehicle_counts.append(road_vehicle_count)

            # Debug value kept for compatibility.
            road_q = 1.0 / (1.0 + road_vehicle_count)

            for lane_id in road_lanes:
                total_lane_count += 1

                try:
                    vehicle_ids = eng.lane.getLastStepVehicleIDs(lane_id)
                    total_vehicle_count += len(vehicle_ids)

                    try:
                        lane_halting = eng.lane.getLastStepHaltingNumber(lane_id)
                    except Exception:
                        lane_halting = 0

                    total_halting_count += lane_halting

                    current_lane_weight = (
                        EV_weight if (EV_present and lane_id == EV_lane_id) else 1.0
                    )

                    lane_weights.append(current_lane_weight)
                    lane_queues.append(road_q)

                    for veh_id in vehicle_ids:
                        try:
                            veh_type = eng.vehicle.getTypeID(veh_id)
                            veh_speed = eng.vehicle.getSpeed(veh_id)
                            waiting_time = eng.vehicle.getAccumulatedWaitingTime(veh_id)

                            if veh_type in ambulance_type_ids:
                                emergency_waiting_times.append(waiting_time)
                                continue

                            regular_speeds.append(veh_speed)

                            if EV_present and lane_id == EV_lane_id:
                                veh_position = eng.vehicle.getLanePosition(veh_id)

                                # Group 1 = normal vehicles in front of EV.
                                if veh_position > EV_position:
                                    ev_front_vehicle_count += 1
                                    regular_group1_waiting_times.append(waiting_time)

                                    if veh_speed < 0.1:
                                        ev_front_halting_count += 1

                                else:
                                    regular_group2_waiting_times.append(waiting_time)
                                    group2_speeds.append(veh_speed)

                            else:
                                regular_group2_waiting_times.append(waiting_time)
                                group2_speeds.append(veh_speed)

                        except Exception:
                            continue

                except Exception:
                    continue

        # Step 4: stable metrics.
        group1_wait_mean = self._safe_mean(regular_group1_waiting_times)
        group2_wait_mean = self._safe_mean(regular_group2_waiting_times)
        emergency_wait_mean = self._safe_mean(emergency_waiting_times)

        group1_wait_std = self._safe_std(regular_group1_waiting_times)
        group2_wait_std = self._safe_std(regular_group2_waiting_times)
        emergency_wait_std = self._safe_std(emergency_waiting_times)

        regular_speed_mean = self._safe_mean(regular_speeds)
        group2_speed_mean = self._safe_mean(group2_speeds)

        halting_per_lane = total_halting_count / max(total_lane_count, 1)
        occupancy_per_lane = total_vehicle_count / max(total_lane_count, 1)

        ev_speed_score = min(EV_speed / speed_norm, 1.0) if EV_present else 0.0
        regular_speed_score = min(regular_speed_mean / speed_norm, 1.0)
        group2_speed_score = min(group2_speed_mean / speed_norm, 1.0)

        if EV_present:
            ev_clearance_score = 1.0 / (
                1.0
                + ev_front_vehicle_count
                + 2.0 * ev_front_halting_count
            )
        else:
            ev_clearance_score = 0.0

        normal_flow_score = 1.0 / (
            1.0
            + group2_wait_mean / wait_norm
            + group2_wait_std / std_norm
            + halting_per_lane / halting_norm
            + occupancy_per_lane / occupancy_norm
        )

        # Civilian multiplier: high when EV is not urgent.
        # This only changes civilian terms. It does not reduce EV reward terms.
        if EV_present:
            ev_block_level = min(
                (ev_front_vehicle_count + 2.0 * ev_front_halting_count) / 5.0,
                1.0
            )
            ev_wait_level = min(emergency_wait_mean / ev_wait_norm, 1.0)
            ev_slow_level = 1.0 - ev_speed_score
            ev_tta_level = (
                (EV_weight - 1.0) / max(max_weight - 1.0, eps)
                if max_weight > 1.0 else 0.0
            )

            ev_urgency = (
                0.45 * ev_block_level
                + 0.30 * ev_wait_level
                + 0.20 * ev_slow_level
                + 0.05 * ev_tta_level
            )
            ev_urgency = float(np.clip(ev_urgency, 0.0, 1.0))
        else:
            ev_block_level = 0.0
            ev_wait_level = 0.0
            ev_slow_level = 0.0
            ev_tta_level = 0.0
            ev_urgency = 0.0

        civilian_multiplier = 1.0 + (civilian_multiplier_max - 1.0) * (1.0 - ev_urgency)
        civilian_multiplier = float(np.clip(civilian_multiplier, 1.0, civilian_multiplier_max))

        # Step 5: positive rewards.
        if EV_present:
            ev_clear_reward = (
                ev_clear_reward_weight
                * EV_weight
                * ev_clearance_score
            )

            ev_speed_reward = (
                ev_speed_reward_weight
                * ev_speed_score
            )
        else:
            ev_clear_reward = 0.0
            ev_speed_reward = 0.0

        normal_flow_reward = (
            normal_flow_reward_weight
            * civilian_multiplier
            * normal_flow_score
        )

        regular_speed_reward = (
            regular_speed_reward_weight
            * civilian_multiplier
            * regular_speed_score
        )

        # Step 6: costs.
        if EV_present:
            front_vehicle_cost = (
                front_vehicle_cost_weight
                * EV_weight
                * ev_front_vehicle_count
            )

            front_halting_cost = (
                front_halting_cost_weight
                * EV_weight
                * ev_front_halting_count
            )

            emergency_wait_cost = (
                emergency_wait_cost_weight
                * EV_weight
                * (emergency_wait_mean / ev_wait_norm)
            )

            group1_wait_cost = (
                group1_wait_cost_weight
                * EV_weight
                * (group1_wait_mean / ev_wait_norm)
            )

            ev_slow_cost = (
                ev_slow_cost_weight
                * (1.0 - ev_speed_score)
            )
        else:
            front_vehicle_cost = 0.0
            front_halting_cost = 0.0
            emergency_wait_cost = 0.0
            group1_wait_cost = 0.0
            ev_slow_cost = 0.0

        group2_excess_wait = max(group2_wait_mean - group2_target_wait, 0.0)

        group2_wait_cost = (
            civilian_multiplier
            * group2_wait_cost_weight
            * (group2_wait_mean / wait_norm)
        )

        group2_std_cost = (
            civilian_multiplier
            * group2_std_cost_weight
            * (group2_wait_std / std_norm)
        )

        group2_excess_wait_cost = (
            civilian_multiplier
            * group2_excess_wait_cost_weight
            * (group2_excess_wait / wait_norm)
        )

        halting_per_lane_cost = (
            civilian_multiplier
            * halting_per_lane_cost_weight
            * (halting_per_lane / halting_norm)
        )

        occupancy_per_lane_cost = (
            civilian_multiplier
            * occupancy_per_lane_cost_weight
            * (occupancy_per_lane / occupancy_norm)
        )

        raw_reward = (
            ev_clear_reward
            + ev_speed_reward
            + normal_flow_reward
            + regular_speed_reward
            - front_vehicle_cost
            - front_halting_cost
            - emergency_wait_cost
            - group1_wait_cost
            - ev_slow_cost
            - group2_wait_cost
            - group2_std_cost
            - group2_excess_wait_cost
            - halting_per_lane_cost
            - occupancy_per_lane_cost
        )

        reward = float(np.clip(raw_reward, reward_clip_min, reward_clip_max))

        lane_queues_arr = np.array(lane_queues)
        lane_weights_arr = np.array(lane_weights)

        if len(lane_queues_arr) > 0:
            total_weighted_queue = float(np.sum(lane_weights_arr * lane_queues_arr))
        else:
            total_weighted_queue = 0.0

        return {
            'reward': reward,
            'raw_reward': float(raw_reward),

            'EV_present': EV_present,
            'EV_id': EV_id,
            'EV_lane_id': EV_lane_id,
