    def _compute_project1_std_reward(self) -> float:
        """
        v7 final year project reward.

        This name is kept because compute_reward() calls:
            self._compute_project1_std_reward()
        """
        components = self._compute_fyp_v7_reward_components()
        return float(components['reward'])

    def _compute_project1_std_reward_with_configurable_params(self, Z=None) -> float:
        """Same v7 reward, but Z can be changed for parameter sweep."""
        components = self._compute_fyp_v7_reward_components(Z=Z)
        return float(components['reward'])

